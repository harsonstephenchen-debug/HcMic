    <Nullable>disable</Nullable>
    <AssemblyName>HcMicClient</AssemblyName>
    <RootNamespace>HcMic</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.1.0</Version>
